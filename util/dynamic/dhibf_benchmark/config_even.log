                awk 'NR>1{m=0; for(i=1;i<=NF;i++){if($i==1){print $1"	"i-2; m=1}};if(m==0){print $1"	"}}' "bifrost/default/${BATCH}.query.tsv" > "bifrost/default/${BATCH}.eval"
                
