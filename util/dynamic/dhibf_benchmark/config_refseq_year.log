localrule cobs_batch_update:
    input: input_data/initial_files.txt, input_data/batches
    output: cobs/default/bench.tsv
    log: cobs/default/batch_update.log
    jobid: 7
    benchmark: cobs/default/batch_update.bench.tsv
    reason: Missing output files: cobs/default/bench.tsv
    wildcards: args=default
    threads: 24
    resources: tmpdir=/tmp
Shell command: 
        if [[ -z "" ]]; then
            last_batch=$(ls input_data/batches/insert_batch_* | wc -l)
        else
            last_batch=
        fi

        for BATCH in $(seq 1 ${last_batch}); do
            echo "${BATCH}" >> cobs/default/batch_update.log
            
            output="cobs/default/${BATCH}.index.cobs_compact"
            cat input_data/initial_files.txt > cobs/default/${BATCH}.list
            seq 1 ${BATCH} | xargs -I {} cat input_data/batches/insert_batch_{}.txt >> cobs/default/${BATCH}.list

            # BUILD FROM SCRATCH
            /usr/bin/time -f "${BATCH}	build	%E	%e	%M	%t	%I	%O	[%C]" -a -o cobs/default/bench.tsv cobs compact-construct --file-type list                         --threads 24                         --term-size 20 --false-positive-rate 0.05 --num-hashes 2                          cobs/default/${BATCH}.list "${output}"  >> cobs/default/batch_update.log 2>&1
            xargs -I {} rm -f {}.cobs_cache < cobs/default/${BATCH}.list

            #SIZE
            du --bytes --dereference --summarize "${output}" | sed "s/^/${BATCH}	size	/" >> cobs/default/bench.tsv

            # QUERY
            if [[ -n "" ]]; then
                /usr/bin/time -f "${BATCH}	query	%E	%e	%M	%t	%I	%O	[%C]" -a -o cobs/default/bench.tsv cobs query --load-complete --threshold 0.8                                                             --index "${output}"                                                             --file ""                                                             --threads 24 > "cobs/default/${BATCH}.query" 2>> cobs/default/batch_update.log
                
                # AVG. QUERY HITS
                grep "^\*" "cobs/default/${BATCH}.query" | cut -f 2 | awk -v batch=${BATCH} '{s+=$1}END{print batch"	avg_query	"s/NR}' >> cobs/default/bench.tsv

                # EVAL
                if [[ "False" == "True" ]]; then
                    awk '{if($1 ~ /^\*/){printf "\n"$1"\t"}else{printf $1"\t"}}END{print ""}' cobs/default/${BATCH}.query | tail -n+2 | tr -d '*' > cobs/default/${BATCH}.eval
                    /home/mi/pirov/code/dhibf_benchmark/scripts/query_eval.py cobs/default/${BATCH}.eval 0 0 | sed "s/^/${BATCH}	/" >> cobs/default/bench.tsv
                fi

                rm "cobs/default/${BATCH}.query"
            fi
            
            # Delete index
            rm -f "${output}" cobs/default/${BATCH}.list
        done
        

